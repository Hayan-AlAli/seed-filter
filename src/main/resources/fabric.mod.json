{
	"schemaVersion": 1,
	"id": "seedfilter",
	"version": "${version}",
	"name": "Seed Filter",
	"description": "Pick your spawn biome, nearby structures and Nether — then press Create New World and the mod finds a matching seed.",
	"license": "MIT",
	"contact": {
		"homepage": "https://modrinth.com/mod/seed-filter",
		"sources": "https://github.com/Hayan-AlAli/seed-filter",
		"issues": "https://github.com/Hayan-AlAli/seed-filter/issues"
	},
	"icon": "assets/seedfilter/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": ["seedfilter.SeedFilterMod"]
	},
	"mixins": ["seedfilter.mixins.json"],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
